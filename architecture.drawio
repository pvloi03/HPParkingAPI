        <mxCell id="edge_win_api" value="REST API &amp; SignalR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2.5;fontSize=11;fontStyle=1;" edge="1" parent="1" source="node_winforms" target="node_api">
